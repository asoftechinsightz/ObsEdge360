# OpsEdge360 — Demo environment sample (never use production secrets)
APP_ENV=demo
OPS_EDGE_ENV=demo
NODE_ENV=production
DEPLOYMENT_MODE=onprem
PERFORMANCE_PROFILE=standard
OUTBOUND_DISABLED=true

POSTGRES_HOST=postgres-demo
POSTGRES_PORT=5432
POSTGRES_USER=opsedge_demo
POSTGRES_PASSWORD=replace-demo-password
POSTGRES_DB=opsedge360_demo

REDIS_URL=redis://redis-demo:6379

JWT_SECRET=replace-demo-jwt-secret-min-32-chars-long
SERVICE_JWT_SECRET=replace-demo-service-jwt-secret
SECRETS_PROVIDER=local
SECRETS_MASTER_KEY=replace-with-openssl-rand-base64-32

AUTH_REQUIRED=true
AUTHZ_ENFORCE=true

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_PACK_BANKING360_ENABLED=true
