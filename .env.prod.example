# OpsEdge360 — Production environment
# Copy to .env on VPS before: docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile core --profile prod up -d --build

NODE_ENV=production
DEPLOYMENT_MODE=saas
PERFORMANCE_PROFILE=standard
AUTH_REQUIRED=true
SWAGGER_ENABLED=false

# Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_256_BIT_SECRET

POSTGRES_USER=trinetra
POSTGRES_PASSWORD=REPLACE_STRONG_PASSWORD
POSTGRES_DB=trinetra360

CORS_ORIGINS=https://observability360.asoftechinsightz.com
NEXT_PUBLIC_AUTH_REQUIRED=true
OBS360_PUBLIC_URL=https://observability360.asoftechinsightz.com
OBS360_PUBLIC_API_URL=https://api.observability360.asoftechinsightz.com
NEXT_PUBLIC_API_URL=https://api.observability360.asoftechinsightz.com

# Optional global OIDC
# SSO_OIDC_ISSUER=
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_DEFAULT_TENANT=default

KAFKA_ENABLED=true
CACHE_ENABLED=true
CACHE_BACKEND=redis

# TLS certs directory (fullchain.pem + privkey.pem) for nginx service
SSL_CERT_PATH=./infra/nginx/certs
