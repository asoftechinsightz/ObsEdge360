# OpsEdge360 host agent configuration
# Copy to agent.env and fill values from UI: /discovery → Agents → Register agent

OBS360_API_URL=http://localhost:4000
# Production example:
# OBS360_API_URL=https://api.observability360.asoftechinsightz.com

OBS360_AGENT_ID=paste-agent-uuid-here
OBS360_AGENT_KEY=obs360_paste-one-time-key-here

# Seconds between reports (heartbeat + metrics)
OBS360_INTERVAL_SEC=30

# Optional override (defaults to OS hostname)
# OBS360_HOSTNAME=web-01.prod.local
