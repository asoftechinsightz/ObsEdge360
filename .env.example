# OpsEdge360 Environment Configuration

# Public URL (production)
OBS360_PUBLIC_URL=http://localhost:3000
OBS360_GATEWAY_URL=http://localhost:4000
OBS360_PUBLIC_API_URL=http://localhost:4000

# Optional global OIDC (on-prem / single-tenant)
# SSO_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_SCOPES=openid email profile
# SSO_DEFAULT_TENANT=default
# SSO_ALLOWED_DOMAINS=company.com

# Deployment topology: saas | hybrid | onprem
DEPLOYMENT_MODE=saas
# Runtime plane (separate DB/secrets): production | demo | development | local | uat | staging
APP_ENV=local
# Performance: local (minimal) | standard | high
PERFORMANCE_PROFILE=standard

# Application
NODE_ENV=development
TENANT_ID=default
AUTH_REQUIRED=false
KAFKA_ENABLED=true

# Caching
CACHE_ENABLED=true
CACHE_BACKEND=redis

# API Gateway
API_GATEWAY_PORT=4000
JWT_SECRET=change-me-in-production-use-256-bit-key
JWT_EXPIRES_IN=24h
CORS_ORIGINS=http://localhost:3000

# Service URLs (API Gateway proxies to these)
CMDB_URL=http://localhost:4002
DISCOVERY_URL=http://localhost:4001
OBSERVABILITY_URL=http://localhost:4003

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=OpsEdge360
NEXT_PUBLIC_AUTH_REQUIRED=false
AUTH_REQUIRED=false

# PostgreSQL (CMDB, compliance, audit)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trinetra
POSTGRES_PASSWORD=trinetra_dev
POSTGRES_DB=trinetra360

# MongoDB (telemetry, events, unstructured)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=trinetra360_events

# Redis (cache, sessions, rate limiting)
REDIS_URL=redis://localhost:6379

# Neo4j (digital twin graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trinetra_dev

# OpenSearch (logs, search, analytics)
OPENSEARCH_URL=http://localhost:9200

# Kafka (event bus)
KAFKA_BROKERS=localhost:9092

# RabbitMQ (task queues)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# AI Agents & Phase 2/3 Services
AI_AGENTS_URL=http://localhost:5000
COMPLIANCE_URL=http://localhost:4004
TRANSACTIONS_URL=http://localhost:4005
SECURITY_URL=http://localhost:4006
REMEDIATION_URL=http://localhost:4007
ANALYTICS_URL=http://localhost:4008
QUANTUM_URL=http://localhost:4009
GOVERNANCE_URL=http://localhost:4010
COMPLIANCE_INTERVAL_MS=300000
OPENAI_API_KEY=
LANGGRAPH_CHECKPOINT_DB=postgresql://trinetra:trinetra_dev@localhost:5432/trinetra360

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=trinetra360

# Discovery connectors (examples)
DISCOVERY_SSH_ENABLED=true
DISCOVERY_SNMP_ENABLED=true
DISCOVERY_K8S_ENABLED=true
